# Local pubspec lock for the validation example — `flutter pub get` writes
# it on each developer's machine; committing it would churn on every
# Flutter SDK update.
/flutter_package/example/pubspec.lock

# Flutter pub tooling state
/flutter_package/example/.dart_tool/
/flutter_package/.dart_tool/

# Cocoapods state for the validation example
/flutter_package/example/ios/Pods/
/flutter_package/example/macos/Pods/
/flutter_package/example/ios/Podfile.lock
/flutter_package/example/macos/Podfile.lock
